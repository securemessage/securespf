# SecureSPF Configuration
# See securespf(8) for details.

[global]
# Identifier used in Authentication-Results headers.
AuthservID      = mail.example.com

# Trust boundary (RFC 8601 section 5).
# SecureSPF always removes pre-existing Authentication-Results headers that
# claim our AuthservID and assert an spf= result, since a remote sender must
# not be able to supply its own SPF verdict.
# Set this to yes on the FIRST milter in the chain to additionally remove
# every other Authentication-Results header claiming our AuthservID. Leave it
# unset on later milters, which must be able to read the results the earlier
# ones produced.
StripAuthResults = yes

# Number of worker threads. 0 = auto-detect CPU count.
WorkerThreads   = 0

# Maximum simultaneous connections accepted by each worker thread.
# Default: 256.
# MaxConnections = 256

# Syslog logging.
Syslog          = yes
SyslogFacility  = mail

# Logging verbosity: err, warn, info, debug.
# LogLevel      = info

# PID file location.
PidFile         = /var/run/securespf/securespf.pid

# Drop privileges to this user, as "user" or "user:group".
#
# The drop happens BEFORE the listeners are bound, not after, which has two
# consequences worth knowing: a unix socket is created owned by this user and
# group, and the directory it lives in must be writable by them.
#
# The optional group is what makes a shared unix socket work -- name the group
# the MTA runs in and set UMask below, and the socket is reachable by Postfix
# and by nothing else.
User            = _spf

# File-creation mask for the PID file and any unix-domain listener.
#
# Read as OCTAL whether or not you write the leading zero. Unset inherits
# whatever mask the supervisor had, which for a unix socket means 0755 --
# world-connectable, and since this daemon writes Authentication-Results that
# a downstream milter trusts, that is every local account inside the trust
# boundary.
#
# 0117 gives a socket at 0660: owner and group only. Pair it with a group in
# User above. This is the only control there is -- a socket takes its mode from
# the umask at bind time, and there is no window-free way to widen or narrow it
# afterwards.
#
# Does not apply to the TCP listener below, which has no filesystem
# permissions; for that, bind to loopback and rely on the host being a
# dedicated milter host.
# UMask         = 0117

# Run in foreground (do not daemonize). Useful for debugging.
# Foreground    = no

# DNS resolver settings.
DnsNameserver   = 127.0.0.1
DnsTimeout      = 5
DnsRetries      = 2

# Maximum entries in the per-worker DNS cache, and the TTL in seconds applied
# to negative answers (NXDOMAIN, SERVFAIL) so a lookup that just failed is not
# retried on every message.
# DnsCacheSize    = 1000
# DnsNegativeTTL  = 60

# --- Resource limits on attacker-controlled message content ---
#
# Both take effect at startup, not on SIGHUP. 0 disables the limit.
#
# SPF is evaluated from the envelope and client IP, so this daemon never buffers
# a message body and has no MaxBodyBytes. It does accumulate the header block, in
# order to strip Authentication-Results headers forging its own AuthservID.
#
# A message whose header block exceeds either limit is tempfailed rather than
# delivered: headers past the limit are never seen, so a forged
# Authentication-Results hidden beyond it could not be stripped. Raise these if
# legitimate mail crossing many forwarders and mailing lists is being deferred.
# MaxHeaders     = 500
# MaxHeaderBytes = 1M

# Bounds on evaluating one SPF record (RFC 7208 section 4.6.4). An SPF record is
# a program the sender writes and the receiver runs, so the receiver is the only
# party in a position to bound it.
#
# MaxVoidLookups is the number of terms whose DNS lookup may find nothing -- an
# authoritative "no such name" or an empty answer -- before the evaluation stops
# with permerror. The RFC makes this a SHOULD and recommends 2, which is why it
# is settable here while the other limits are not.
#
# MaxEvaluationMs is the wall-clock ceiling in milliseconds. Exhausting it gives
# temperror, not a verdict: the evaluation was incomplete, and answering "fail"
# would reject mail on terms that were never read. The RFC asks for a time limit
# without naming a value; 20 seconds is what section 10.1 suggests for a whole
# check.
#
# 0 disables either limit. Two further limits are fixed at 10 and not
# configurable, because senders design records against those exact numbers: the
# DNS-querying terms per evaluation (a, mx, ptr, exists, include, redirect), and
# the records examined inside one mx or ptr mechanism.
#
# When a limit or any other condition ends an evaluation early, securespf logs a
# second line for the message carrying "reason=" and the RFC section, because
# permerror on its own does not say whether a record was malformed or merely
# too expensive.
# MaxVoidLookups  = 2
# MaxEvaluationMs = 20000

# ZMQ event publishing endpoint (optional).
# If not set, events are silently dropped.
# ZmqEndpoint   = tcp://events.internal:5555

# ZeroMQ topic prefix events are published under. Default: spf.result.
# ZmqTopic      = spf.result

# Loopback. "inbound" describes the mail, not this socket: the client is always the
# local Postfix. The milter protocol has no authentication, so anything that can
# reach this port supplies the client IP, HELO and MAIL FROM that check_host() runs
# on -- it chooses the SPF result this host will stamp. Widen only if Postfix
# genuinely runs on another machine, and then restrict it with pf.
[listener:inbound]
# The address must be numeric: no DNS is performed, so inet:PORT@localhost is a
# configuration ERROR, not a synonym for 127.0.0.1. A Socket value that cannot be
# parsed stops startup and names this section; it is never silently ignored and
# never falls back to the default listener.
Socket          = inet:8890@127.0.0.1

# Optional: hosts/networks that bypass SPF checking.
# WhitelistFile = /usr/local/etc/securespf/whitelist
